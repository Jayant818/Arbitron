# Redis connection URL
REDIS_URL=redis://localhost:6379

# Solana RPC endpoint
RPC_URL=https://api.devnet.solana.com

# Path to your wallet keypair JSON file
HOST_WALLET_PATH=/path/to/your/wallet.json

# Your Arbitron program ID (note the typo in the variable name)
ARBITRON_PROGRM_ID=YourProgramIdHere

# ZK Program Image ID (hex string from manifest.json)
ZK_PROGRAM_IMAGE_ID=your_image_id_hex_here

# Specific prover public key
SPECIFIC_PROVER_KEY=ProverPubkeyHere
