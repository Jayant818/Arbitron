{
  "name": "arbitron",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "programs/*",
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "show-versions": "bash show-versions.sh",
    "regenerate-client": "anchor build && npx tsx create-codama-client.ts",
    "dev": "turbo dev"
  },
  "dependencies": {
    "@codama/nodes-from-anchor": "^1.2.9",
    "@codama/renderers": "^1.0.34",
    "@coral-xyz/anchor": "^0.31.1",
    "@solana-program/system": "^0.8.1",
    "@solana-program/token": "^0.6.0",
    "@solana/kit": "^3.0.3",
    "@solana/spl-token": "^0.4.14",
    "@tanstack/react-query": "^5.90.2",
    "codama": "^1.3.7",
    "react-icons": "^5.5.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "prettier": "^2.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.7.3"
  }
}
